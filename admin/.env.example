# Sao chép thành .env rồi điền thông tin dự án Supabase.
# Lấy ở Supabase Dashboard › Project Settings › API.
#
# Chỉ dùng anon key ở đây. TUYỆT ĐỐI không đặt service_role key vào file này —
# nó nằm trong mã chạy ở trình duyệt, ai mở DevTools cũng đọc được.
VITE_SUPABASE_URL=http://127.0.0.1:54531
VITE_SUPABASE_ANON_KEY=thay-bang-anon-key-cua-ban

# Cloudinary: KHÔNG đặt ở đây. API secret mà nằm trong biến VITE_ thì bị đóng
# vào mã JS, ai mở trang cũng đọc được. Đặt làm secret của Edge Function:
#   supabase secrets set CLOUDINARY_CLOUD_NAME=... CLOUDINARY_API_KEY=... CLOUDINARY_API_SECRET=...
# Chưa đặt thì ảnh tải lên Supabase Storage.
